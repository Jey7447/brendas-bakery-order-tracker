# n8n webhook that receives customer order events.
N8N_ORDER_WEBHOOK_URL=https://your-n8n-host.example/webhook/brendas-bakery-order

# n8n webhook that returns orders for the Brenda dashboard.
N8N_DASHBOARD_WEBHOOK_URL=https://your-n8n-host.example/webhook/brendas-bakery-dashboard

# n8n webhook used by the dashboard to mark an order as paid.
N8N_UPDATE_ORDER_WEBHOOK_URL=https://your-n8n-host.example/webhook/brendas-bakery-update-order

# n8n webhook used by customers to look up one order.
N8N_TRACK_ORDER_WEBHOOK_URL=https://your-n8n-host.example/webhook/brendas-bakery-track-order

# Optional shared secret sent to n8n.
N8N_WEBHOOK_SECRET=replace-me
